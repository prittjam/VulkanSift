#version 450
//
// QuantizeF32ToInput.comp — device-side R32F→R8_UNORM copy with quantization.
//
// Reads from the IMAS pipeline's `rotated_image` (Float32, normalized to [0, 1])
// and writes into the SIFT detector's `input_image` (R8_UNORM). Skips the
// host roundtrip that used to consume 91% of the full-GPU IMAS wallclock.
//
// Output dims are constrained by push_const.width/height, which the caller
// sets to the actual IMAS-tilted output size (the rotated_image is allocated
// at max W×H and the IMAS pipeline writes into the top-left out_w × out_h
// sub-region).
//
// Bindings:
//   0: image2D r32f input  (rotated_image — output of the IMAS pipeline)
//   1: image2D r8  output (input_image — fed into the SIFT detector)
//

layout(local_size_x = 8, local_size_y = 8) in;
layout(r32f, binding = 0) uniform image2D img_input;
layout(r8,   binding = 1) uniform image2D img_output;

layout(push_constant) uniform PushConst {
    uint width;
    uint height;
} push_const;

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= int(push_const.width) || coords.y >= int(push_const.height)) return;
    float v = imageLoad(img_input, coords).r;
    // R8_UNORM hardware-converts float in [0, 1] → byte 0..255 on store.
    imageStore(img_output, coords, vec4(clamp(v, 0.0, 1.0), 0.0, 0.0, 1.0));
}
