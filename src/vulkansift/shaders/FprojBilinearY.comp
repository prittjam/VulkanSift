#version 450
//
// FprojBilinearY.comp — bilinear y-subsample.
//
// Drop-in replacement for the cubic-B-spline path (FinvsplineRow +
// FinvsplineCol + FprojCubicY). Empirically the cubic IIR pre-filter
// contributes <0.01% feature-count delta in the ASIFT pipeline because
// the downstream SIFT pyramid's first Gaussian re-blurs the interpolation
// residual. Bilinear is one fully-parallel pass per warp.
//
// Same sampling geometry as the cubic path:
//   Output (x, y) samples input at (xp, yp) = (x + 0.5, t·y + 0.5).
//   OOB → bg_value.
//
// Input: post-σ_aa-blur rotated image (width_r × height_r).
// Output: tilted image (width_r × ⌊height_r/t⌋).
//

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32f) uniform image2D img_in;
layout(set = 0, binding = 1, r32f) uniform image2D img_out;

layout(set = 1, binding = 0, std140) uniform WarpParamsBlock {
    float a11, a12, a13;
    float a21, a22, a23;
    float fill_value;
    float fproj_bg_value;
    uint  W_rot, H_rot, H_sub, canvas_w, canvas_h, valid_w, valid_h, warp_idx;
    float sigma_aa, t_factor, quantize_fill, gauss_dir_x, gauss_dir_y;
    float _pad1, _pad2, _pad3;
} ubo;
// FprojBilinearY mapping:
//   output dims  = (W_rot, H_sub)
//   input dims   = (W_rot, H_rot)
//   subsample t  = t_factor
//   OOB fill     = fill_value

float fetch(int x, int y) {
    int W = int(ubo.W_rot);
    int H = int(ubo.H_rot);
    if (x < 0 || x >= W || y < 0 || y >= H) return ubo.fproj_bg_value;
    return imageLoad(img_in, ivec2(x, y)).r;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= int(ubo.W_rot) || y >= int(ubo.H_sub)) return;

    float xp = float(x) + 0.5;
    float yp = ubo.t_factor * float(y) + 0.5;
    if (xp < 0.0 || xp > float(ubo.W_rot)  ||
        yp < 0.0 || yp > float(ubo.H_rot)) {
        imageStore(img_out, ivec2(x, y), vec4(ubo.fproj_bg_value, 0.0, 0.0, 1.0));
        return;
    }

    xp -= 0.5; yp -= 0.5;
    int xi = int(floor(xp));
    int yi = int(floor(yp));
    float ux = xp - float(xi);
    float uy = yp - float(yi);

    float v00 = fetch(xi,     yi);
    float v01 = fetch(xi + 1, yi);
    float v10 = fetch(xi,     yi + 1);
    float v11 = fetch(xi + 1, yi + 1);

    float v = (1.0 - ux) * (1.0 - uy) * v00
            +        ux  * (1.0 - uy) * v01
            + (1.0 - ux) *        uy  * v10
            +        ux  *        uy  * v11;
    imageStore(img_out, ivec2(x, y), vec4(v, 0.0, 0.0, 1.0));
}
