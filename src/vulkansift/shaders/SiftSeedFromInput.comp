#version 450
//
// SiftSeedFromInput.comp — IMAS-fused fast-path that replaces the
// PreBlur1D + AffineWarp + (CopyImage|Upsample2xLinear) chain at octave-0
// with a single dispatch. Reads slot.rotated_image (R32F, IMAS fproj output)
// and writes the R32F seed layer of octave_image_arr[0] (i.e. layer 0).
//
// For use_upsampling=false: dst_w == src_w, so the bilinear weights collapse
// to nearest-center and the dispatch is a pure R32F copy.
// For use_upsampling=true: dst_w == 2·src_w; the bilinear formula below is
// bit-equivalent to Upsample2xLinear.comp.
//
// Bypasses QuantizeF32ToInput entirely: reading R32F directly avoids the
// R8 quantization roundtrip and the host-side cost of running Quantize. The
// (valid_w, valid_h, quantize_fill) UBO fields replicate Quantize's
// out-of-IMAS-region fill behaviour so the SIFT pyramid sees an identical
// padded canvas.
//
// Bindings:
//   set=0, binding=0: image2D r32f (rotated_image, post-IMAS-fproj)
//   set=0, binding=1: image2DArray r32f (octave_image_view_arr[0])
//   set=1, binding=0: WarpParamsBlock UBO (consumes valid_w/h, quantize_fill)
//
layout(local_size_x = 8, local_size_y = 8) in;
layout(r32f, set = 0, binding = 0) uniform image2D       img_input;
layout(r32f, set = 0, binding = 1) uniform image2DArray  img_output;

layout(set = 1, binding = 0, std140) uniform WarpParamsBlock {
    float a11, a12, a13;
    float a21, a22, a23;
    float fill_value;
    float fproj_bg_value;
    uint  W_rot, H_rot, H_sub, canvas_w, canvas_h, valid_w, valid_h, warp_idx;
    float sigma_aa, t_factor, quantize_fill, gauss_dir_x, gauss_dir_y;
    float _pad1, _pad2, _pad3;
} ubo;

layout(push_constant) uniform PushConst {
    int dst_layer;
    int dst_width;
    int dst_height;
    int src_width;
    int src_height;
} push_const;

float fetch(int x, int y) {
    // Replicate QuantizeF32ToInput's fill rule: anything outside the
    // IMAS-written sub-region (valid_w × valid_h) is quantize_fill.
    if (x < 0 || x >= int(ubo.valid_w) ||
        y < 0 || y >= int(ubo.valid_h)) {
        return ubo.quantize_fill;
    }
    return imageLoad(img_input, ivec2(x, y)).r;
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= push_const.dst_width || coords.y >= push_const.dst_height) return;

    float ratio_x = float(push_const.src_width)  / float(push_const.dst_width);
    float ratio_y = float(push_const.src_height) / float(push_const.dst_height);
    float u = (float(coords.x) + 0.5) * ratio_x - 0.5;
    float v = (float(coords.y) + 0.5) * ratio_y - 0.5;

    int x0 = int(floor(u));
    int y0 = int(floor(v));
    float fx = u - float(x0);
    float fy = v - float(y0);

    float v00 = fetch(x0,     y0    );
    float v10 = fetch(x0 + 1, y0    );
    float v01 = fetch(x0,     y0 + 1);
    float v11 = fetch(x0 + 1, y0 + 1);

    float top    = mix(v00, v10, fx);
    float bottom = mix(v01, v11, fx);
    float result = mix(top, bottom, fy);

    imageStore(img_output, ivec3(coords, push_const.dst_layer), vec4(result, 0.0, 0.0, 1.0));
}
