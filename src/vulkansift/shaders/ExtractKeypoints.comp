#version 450
//
// ExtractKeypoints.comp — boundary-aware 3D NMS + Newton subpixel refinement.
//
// For each (x, y, s) in the DoG scale-space cube of one octave, test whether
// the value is a strict local extremum compared to the available 3×3×3
// neighborhood. Boundary scale slices (s == 0 or s == num_slices - 1) only
// compare against the 17 neighbors that exist (same slice + the one adjacent
// slice). Newton subpixel refinement runs only on interior slices.
//
// Dispatch: groupCount.z == num_dog_slices (= nb_scales_per_octave + 2). The
// caller pushes nb_scales_per_octave through push_const.nb_scales so the σ
// formula stays correct regardless of the dispatch range.
//

#define NB_HIST 4
#define NB_ORI 8
#define NB_REFINEMENT_STEP 5

struct SIFT_Feat {
  float x;
  float y;
  float scale_x;
  float scale_y;
  uint scale_idx;
  int octave_idx;
  float sigma;
  float orientation;
  float intensity;
  uint descriptor[(NB_HIST*NB_HIST*NB_ORI)/4];
};

layout(local_size_x = 8, local_size_y = 8) in;
layout(r32f, binding = 0) uniform image2DArray dog_input;
layout(std430, binding = 1) buffer SIFT_buffer {
    uint nb_elem;
    uint max_nb_feat;
    SIFT_Feat data[];
};
layout(std430, binding = 2) buffer IndispatchBuffer {
    uint nb_x_group;
    uint nb_y_group;
    uint nb_z_group;
};

layout(push_constant) uniform PushConst {
  int octave_idx;
  float seed_scale_sigma;
  float dog_threshold;
  float edge_threshold;
  int nb_scales;     // = nb_scales_per_octave, used as divisor in sigma formula
} push_const;


float getVal(int scale_idx, int x, int y) {
    return imageLoad(dog_input, ivec3(x, y, scale_idx)).r;
}

// 8-neighbor strict-greater check on a single slice (excluding center pixel).
bool greater_than_8(float c, int s, int x, int y) {
    return c > getVal(s, x-1, y-1) && c > getVal(s, x  , y-1) && c > getVal(s, x+1, y-1) &&
           c > getVal(s, x-1, y  )                            && c > getVal(s, x+1, y  ) &&
           c > getVal(s, x-1, y+1) && c > getVal(s, x  , y+1) && c > getVal(s, x+1, y+1);
}
// 9-neighbor strict-greater (8-neighbor + center on the same slice). For
// adjacent-scale comparisons, the center pixel at (x, y, s±1) is included.
bool greater_than_9(float c, int s, int x, int y) {
    return c > getVal(s, x  , y  ) && greater_than_8(c, s, x, y);
}
bool less_than_8(float c, int s, int x, int y) {
    return c < getVal(s, x-1, y-1) && c < getVal(s, x  , y-1) && c < getVal(s, x+1, y-1) &&
           c < getVal(s, x-1, y  )                            && c < getVal(s, x+1, y  ) &&
           c < getVal(s, x-1, y+1) && c < getVal(s, x  , y+1) && c < getVal(s, x+1, y+1);
}
bool less_than_9(float c, int s, int x, int y) {
    return c < getVal(s, x  , y  ) && less_than_8(c, s, x, y);
}

void main() {

    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int s = int(gl_GlobalInvocationID.z);   // 0-indexed slice; range [0, num_slices-1]

    int image_width  = imageSize(dog_input).x;
    int image_height = imageSize(dog_input).y;
    int num_slices   = imageSize(dog_input).z;

    // Interior-only 3D NMS: boundary slices (s=0, s=num_slices-1) are NEVER
    // candidates. A candidate at a boundary slice lacks one z-neighbor; the
    // response may still be rising or falling on the missing side (the true
    // peak sits in the adjacent octave). Cube layout has overlap built in:
    // octave o's top slice coincides with octave o+1's bottom slice in σ,
    // so restricting candidates to interior slices still covers the full σ
    // range across the pyramid without cross-octave duplicates.
    if (s <= 0 || s >= num_slices - 1) return;

    if(x>=1 && x < (image_width-1) && y>=1 && y < (image_height-1)) {

        float center_value = getVal(s, x, y);
        if (abs(center_value) <= (push_const.dog_threshold * 0.8f)) return;

        // Full 3D NMS — both s-1 and s+1 always exist (guarded above).
        bool is_max = greater_than_8(center_value, s, x, y) &&
                      greater_than_9(center_value, s - 1, x, y) &&
                      greater_than_9(center_value, s + 1, x, y);
        bool is_min = false;
        if (!is_max) {
            is_min = less_than_8(center_value, s, x, y) &&
                     less_than_9(center_value, s - 1, x, y) &&
                     less_than_9(center_value, s + 1, x, y);
        }
        bool is_best_in_neighborhood = is_max || is_min;

        if(is_best_in_neighborhood) {

            // Newton subpixel refinement; always interior here.
            bool can_refine = true;

            float subpix_x = float(x);
            float subpix_y = float(y);
            float subpix_s = float(s);
            float new_val  = center_value;
            float offset_X = 0.f;
            float offset_Y = 0.f;
            float offset_S = 0.f;
            int refined_x = x;
            int refined_y = y;
            int refined_s = s;
            bool is_refinement_valid = true;

            if (can_refine) {
                float gX,gY,gS;
                for (int step_cnt = 0; step_cnt < NB_REFINEMENT_STEP; step_cnt++)
                {
                    // Gradient
                    gS = 0.5f * (getVal(refined_s+1,refined_x,refined_y) - getVal(refined_s-1,refined_x,refined_y));
                    gX = 0.5f * (getVal(refined_s,refined_x+1,refined_y) - getVal(refined_s,refined_x-1,refined_y));
                    gY = 0.5f * (getVal(refined_s,refined_x,refined_y+1) - getVal(refined_s,refined_x,refined_y-1));
                    // Hessian
                    float h11 = getVal(refined_s+1,refined_x,refined_y) + getVal(refined_s-1,refined_x,refined_y) - 2.f * getVal(refined_s,refined_x,refined_y);
                    float h22 = getVal(refined_s,refined_x+1,refined_y) + getVal(refined_s,refined_x-1,refined_y) - 2.f * getVal(refined_s,refined_x,refined_y);
                    float h33 = getVal(refined_s,refined_x,refined_y+1) + getVal(refined_s,refined_x,refined_y-1) - 2.f * getVal(refined_s,refined_x,refined_y);

                    float h12 = 0.25f * (getVal(refined_s+1,refined_x+1,refined_y) - getVal(refined_s+1,refined_x-1,refined_y) -
                                        getVal(refined_s-1,refined_x+1,refined_y) + getVal(refined_s-1,refined_x-1,refined_y));
                    float h13 = 0.25f * (getVal(refined_s+1,refined_x,refined_y+1) - getVal(refined_s+1,refined_x,refined_y-1) -
                                        getVal(refined_s-1,refined_x,refined_y+1) + getVal(refined_s-1,refined_x,refined_y-1));
                    float h23 = 0.25f * (getVal(refined_s,refined_x+1,refined_y+1) - getVal(refined_s,refined_x+1,refined_y-1) -
                                        getVal(refined_s,refined_x-1,refined_y+1) + getVal(refined_s,refined_x-1,refined_y-1));

                    // Inverted Hessian
                    float determinant = h11 * ((h22 * h33) - (h23 * h23)) - h12 * ((h12 * h33) - (h13 * h23)) + h13 * ((h12 * h23) - (h13 * h22));
                    if (determinant != 0.0f)
                    {
                        float inv_h11 = ((h22 * h33) - (h23 * h23)) / determinant;
                        float inv_h22 = ((h11 * h33) - (h13 * h13)) / determinant;
                        float inv_h33 = ((h11 * h22) - (h12 * h12)) / determinant;
                        float inv_h12 = -((h12 * h33) - (h13 * h23)) / determinant;
                        float inv_h13 = ((h12 * h23) - (h13 * h22)) / determinant;
                        float inv_h23 = -((h11 * h23) - (h13 * h12)) / determinant;

                        offset_S = -(inv_h11 * gS + inv_h12 * gX + inv_h13 * gY);
                        offset_X = -(inv_h12 * gS + inv_h22 * gX + inv_h23 * gY);
                        offset_Y = -(inv_h13 * gS + inv_h23 * gX + inv_h33 * gY);
                    }
                    else
                    {
                        is_refinement_valid = false;
                        break;
                    }

                    if (abs(offset_X) < 0.6f && abs(offset_Y) < 0.6f && abs(offset_S) < 0.6f)
                    {
                        break;
                    }
                    else if(step_cnt<(NB_REFINEMENT_STEP-1))
                    {
                        refined_x = int(round(float(refined_x) + offset_X));
                        refined_y = int(round(float(refined_y) + offset_Y));
                        refined_s = int(round(float(refined_s) + offset_S));
                        if (refined_x < 1 || refined_x >= image_width  - 1 ||
                            refined_y < 1 || refined_y >= image_height - 1 ||
                            refined_s < 1 || refined_s >= num_slices    - 1)
                        {
                            is_refinement_valid = false;
                            break;
                        }
                    }
                }

                bool good_refine = is_refinement_valid &&
                                   abs(offset_X) < 1.5f &&
                                   abs(offset_Y) < 1.5f &&
                                   abs(offset_S) < 1.5f;
                if(good_refine) {
                    subpix_x = float(refined_x) + offset_X;
                    subpix_y = float(refined_y) + offset_Y;
                    subpix_s = float(refined_s) + offset_S;
                    new_val  = getVal(refined_s, refined_x, refined_y) + 0.5f * (gS*offset_S + gX*offset_X + gY*offset_Y);
                } else {
                    // Lenient refine: Newton failed → keep the ORIGINAL discrete
                    // extremum at (x, y, s) — the pre-walk integer position — and
                    // let the spatial edge filter below re-test. Mirrors VGF's
                    // _refine!{Val{true}} commit d28cb2f, which preserves soft
                    // peaks / saddle-walk / boundary-walk extrema that strict
                    // Newton can't fit cleanly but are still real 3D NMS extrema.
                    subpix_x = float(x);
                    subpix_y = float(y);
                    subpix_s = float(s);
                    new_val  = center_value;
                    refined_x = x;
                    refined_y = y;
                    refined_s = s;
                }
            } else {
                // Boundary slice (s == 0 or s == num_slices - 1). No 3D Hessian
                // available, so we emit the extremum at the integer pixel and
                // let the spatial edge filter decide.
                subpix_x = float(x); subpix_y = float(y); subpix_s = float(s);
                new_val  = center_value;
            }

            // Validity: peak above threshold and refined position in bounds.
            if ( abs(new_val) > push_const.dog_threshold &&
                 subpix_x >= 0 && subpix_x <= float(image_width  - 1) &&
                 subpix_y >= 0 && subpix_y <= float(image_height - 1) &&
                 subpix_s >= 0 && subpix_s <= float(num_slices   - 1))
            {
                // 2D Hessian edge filter on the spatial plane at the discrete pixel.
                float h11 = getVal(refined_s,refined_x+1,refined_y) + getVal(refined_s,refined_x-1,refined_y) - 2.f * getVal(refined_s,refined_x,refined_y);
                float h22 = getVal(refined_s,refined_x,refined_y+1) + getVal(refined_s,refined_x,refined_y-1) - 2.f * getVal(refined_s,refined_x,refined_y);
                float h12 = 0.25f * (getVal(refined_s,refined_x+1,refined_y+1) - getVal(refined_s,refined_x+1,refined_y-1) -
                    getVal(refined_s,refined_x-1,refined_y+1) + getVal(refined_s,refined_x-1,refined_y-1));

                float edgeness = ((h11+h22)*(h11+h22)) / ((h11 * h22) - (h12 * h12));
                if ((edgeness < (pow(push_const.edge_threshold + 1, 2.0f) / push_const.edge_threshold)) && (edgeness >= 0))
                {
                    uint idx = atomicAdd(nb_elem, 1);
                    if(idx<max_nb_feat) {
                        atomicAdd(nb_x_group, 1);
                        float scale_factor = pow(2.f, push_const.octave_idx);
                        data[idx].scale_x   = subpix_x;
                        data[idx].scale_y   = subpix_y;
                        data[idx].scale_idx = uint(round(subpix_s));
                        data[idx].octave_idx = push_const.octave_idx;
                        // Sigma divisor is the SIFT octave_resolution (= nb_scales),
                        // independent of dispatch range. Passed via push constant
                        // so the boundary-aware dispatch (nb_scales + 2) doesn't
                        // break the formula.
                        // σ-slice convention:
                        //   At octaves > 0, the DoG cube inherits a downsampled "subdiv -1"
                        //   boundary slice from the previous octave's top. Cube slot z therefore
                        //   corresponds to subdivision (z - 1), and the standard Lowe-formula
                        //   σ = σ_seed * 2^(subdiv_idx / S) * 2^o evaluates as σ_seed *
                        //   2^(subpix_s / S) * 2^o — exactly what's below.
                        //   At octave 0 there is no preceding octave: cube slot z corresponds
                        //   to subdivision z (no -1 offset). To keep the σ formula correct we
                        //   add +1 to subpix_s for octave 0 only.
                        float sigma_subdiv = (push_const.octave_idx == 0) ? (subpix_s + 1.0) : subpix_s;
                        data[idx].sigma     = push_const.seed_scale_sigma * pow(2.f, sigma_subdiv/float(push_const.nb_scales)) * scale_factor;
                        data[idx].orientation = 0.f;
                        data[idx].intensity = new_val;
                        // Convert octave-pixel position to INPUT pixel index
                        // (Vulkan 0-indexed convention). Each downsample via
                        // vkCmdBlitImage with VK_FILTER_NEAREST samples source
                        // texel (2i + 1) for destination texel i, accumulating
                        // an offset of (2^o - 1) input pixels per octave.
                        // Caller adds +0.5 to convert to COLMAP center.
                        data[idx].x = subpix_x*scale_factor + (scale_factor - 1.0);
                        data[idx].y = subpix_y*scale_factor + (scale_factor - 1.0);
                    }
                }
            }
        }
    }
}
