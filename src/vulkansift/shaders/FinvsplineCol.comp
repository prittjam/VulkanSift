#version 450
//
// FinvsplineCol.comp — column IIR pass for cubic B-spline coefficients.
//
// Same as FinvsplineRow.comp but operates along the column axis. Dispatched
// AFTER FinvsplineRow on the same image. One thread per IMAGE COLUMN; each
// thread runs the causal + anticausal IIR filter along its column of H
// pixels.
//
// In place: reads and writes the same image. Matches splines.cpp invspline1D
// invocation on the transposed buffer (columns of the original).
//

layout(local_size_x = 64) in;
layout(r32f, binding = 0) uniform image2D img;

layout(push_constant) uniform PushConst {
    uint width;
    uint height;
} push_const;

const float POLE   = -0.26794919;
const float INV_Z  = -3.7320508;
const float LAMBDA = 6.0;

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= push_const.width) return;
    int H = int(push_const.height);

    // 1. λ scaling of this column
    for (int i = 0; i < H; ++i) {
        float v = imageLoad(img, ivec2(int(c), i)).r;
        imageStore(img, ivec2(int(c), i), vec4(v * LAMBDA, 0.0, 0.0, 1.0));
    }

    // 2. initcausal — POLE negative; GLSL pow() undefined for negative base.
    float zk  = POLE;
    float z2k_mag = pow(abs(POLE), float(H - 1));
    float z2k = (((H - 1) & 1) != 0) ? -z2k_mag : z2k_mag;
    float s   = imageLoad(img, ivec2(int(c), 0)).r
              + z2k * imageLoad(img, ivec2(int(c), H - 1)).r;
    z2k = z2k * z2k * INV_Z;
    for (int k = 1; k <= H - 2; ++k) {
        s   += (zk + z2k) * imageLoad(img, ivec2(int(c), k)).r;
        zk  *= POLE;
        z2k *= INV_Z;
    }
    float c0 = s / (1.0 - zk * zk);
    imageStore(img, ivec2(int(c), 0), vec4(c0, 0.0, 0.0, 1.0));

    // 3. Causal
    float prev = c0;
    for (int n = 1; n < H; ++n) {
        float cur = imageLoad(img, ivec2(int(c), n)).r + POLE * prev;
        imageStore(img, ivec2(int(c), n), vec4(cur, 0.0, 0.0, 1.0));
        prev = cur;
    }

    // 4. initanticausal
    float cN1 = prev;
    float cN2 = imageLoad(img, ivec2(int(c), H - 2)).r;
    float cN1_new = (POLE / (POLE * POLE - 1.0)) * (POLE * cN2 + cN1);
    imageStore(img, ivec2(int(c), H - 1), vec4(cN1_new, 0.0, 0.0, 1.0));

    // 5. Anticausal
    prev = cN1_new;
    for (int n = H - 2; n >= 0; --n) {
        float cn = imageLoad(img, ivec2(int(c), n)).r;
        float new_cn = POLE * (prev - cn);
        imageStore(img, ivec2(int(c), n), vec4(new_cn, 0.0, 0.0, 1.0));
        prev = new_cn;
    }
}
